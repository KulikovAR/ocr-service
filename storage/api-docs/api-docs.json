{
    "openapi": "3.0.0",
    "info": {
        "title": "Document Recognition API",
        "description": "API для распознавания документов через внешний сервис bescan.ru",
        "contact": {
            "name": "API Support",
            "email": "support@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8080/api/v1",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/analytics": {
            "get": {
                "tags": [
                    "Analytics"
                ],
                "summary": "Получить аналитику распознавания документов",
                "description": "Возвращает статистику по распознаванию документов за указанный период",
                "operationId": "getAnalytics",
                "parameters": [
                    {
                        "name": "start_date",
                        "in": "query",
                        "description": "Начальная дата периода (формат: Y-m-d)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-01-01"
                        }
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "description": "Конечная дата периода (формат: Y-m-d)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-12-31"
                        }
                    },
                    {
                        "name": "document_type",
                        "in": "query",
                        "description": "Фильтр по типу документа",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PASSPORT",
                                "PASSPORT_REG",
                                "DLIC",
                                "SNILS",
                                "STS"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Аналитика получена успешно",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "total_requests": {
                                                    "description": "Общее количество запросов",
                                                    "type": "integer",
                                                    "example": 1000
                                                },
                                                "successful_requests": {
                                                    "description": "Успешных запросов",
                                                    "type": "integer",
                                                    "example": 950
                                                },
                                                "failed_requests": {
                                                    "description": "Неудачных запросов",
                                                    "type": "integer",
                                                    "example": 50
                                                },
                                                "success_rate": {
                                                    "description": "Процент успешных запросов",
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 95
                                                },
                                                "average_processing_time": {
                                                    "description": "Среднее время обработки в секундах",
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 2.5
                                                },
                                                "requests_by_type": {
                                                    "description": "Запросы по типам документов",
                                                    "type": "object",
                                                    "example": {
                                                        "PASSPORT": 500,
                                                        "DLIC": 300
                                                    }
                                                },
                                                "requests_by_status": {
                                                    "description": "Запросы по статусам",
                                                    "type": "object",
                                                    "example": {
                                                        "completed": 950,
                                                        "failed": 50
                                                    }
                                                },
                                                "daily_stats": {
                                                    "description": "Ежедневная статистика",
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Доступ запрещен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Access denied."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/recognize": {
            "post": {
                "tags": [
                    "Document Recognition"
                ],
                "summary": "Отправить документ на распознавание",
                "description": "Отправляет документ на распознавание во внешний сервис bescan.ru",
                "operationId": "recognizeDocument",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "document_id",
                                    "document_type",
                                    "images"
                                ],
                                "properties": {
                                    "document_id": {
                                        "description": "Уникальный идентификатор документа",
                                        "type": "string",
                                        "example": "doc_123"
                                    },
                                    "document_type": {
                                        "description": "Тип документа",
                                        "type": "string",
                                        "enum": [
                                            "PASSPORT",
                                            "PASSPORT_REG",
                                            "DLIC",
                                            "SNILS",
                                            "STS"
                                        ],
                                        "example": "PASSPORT"
                                    },
                                    "images": {
                                        "description": "Массив изображений в формате base64",
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "format": "base64"
                                        },
                                        "example": [
                                            "/9j/4AAQSkZJRgABAQEASABIAAD/4gIYSUNDX1BST0ZJTEUAAQEAAAIIAAAAAAQwAABtbnRyUkdCIFhZWiAH"
                                        ]
                                    },
                                    "callback_url": {
                                        "description": "URL для отправки результата распознавания",
                                        "type": "string",
                                        "format": "url",
                                        "example": "https://example.com/webhook"
                                    },
                                    "metadata": {
                                        "description": "Дополнительные метаданные",
                                        "type": "object",
                                        "example": {
                                            "user_id": 123,
                                            "session_id": "abc123"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Документ успешно отправлен на распознавание",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "task_id": {
                                            "description": "ID задачи в системе",
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "document_id": {
                                            "description": "ID документа (дублирует task_id)",
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "external_task_id": {
                                            "description": "ID задачи во внешнем сервисе",
                                            "type": "string",
                                            "example": "s-12345"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Document sent for recognition"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Ошибка при отправке документа",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "External API error: Connection timeout"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "The given data was invalid."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "document_type": [
                                                    "The document type field is required."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/status/{task_id}": {
            "get": {
                "tags": [
                    "Document Recognition"
                ],
                "summary": "Получить статус задачи распознавания",
                "description": "Возвращает текущий статус задачи распознавания и результат, если готов",
                "operationId": "getTaskStatus",
                "parameters": [
                    {
                        "name": "task_id",
                        "in": "path",
                        "description": "ID задачи, внешний ID задачи или ID документа",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "1"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Статус задачи получен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "task_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "document_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "external_task_id": {
                                            "type": "string",
                                            "example": "s-12345"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "pending",
                                                "processing",
                                                "completed",
                                                "failed"
                                            ],
                                            "example": "completed"
                                        },
                                        "document_type": {
                                            "type": "string",
                                            "example": "PASSPORT"
                                        },
                                        "metadata": {
                                            "type": "object",
                                            "example": {
                                                "user_id": 123
                                            }
                                        },
                                        "data": {
                                            "description": "Распознанные данные (только для completed)",
                                            "type": "object",
                                            "example": {
                                                "Series": "1234",
                                                "Number": "567890"
                                            }
                                        },
                                        "confidences": {
                                            "description": "Уверенность в распознавании (только для completed)",
                                            "type": "object",
                                            "example": {
                                                "Series": 0.95
                                            }
                                        },
                                        "verifications": {
                                            "description": "Результаты верификации (только для completed)",
                                            "type": "object",
                                            "example": {
                                                "Series": {
                                                    "valid": true
                                                }
                                            }
                                        },
                                        "error": {
                                            "description": "Описание ошибки (только для failed)",
                                            "type": "string",
                                            "example": "Document processing failed"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Задача не найдена",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Task not found"
                                        },
                                        "code": {
                                            "type": "integer",
                                            "example": 404
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Проверка работоспособности сервиса",
                "description": "Возвращает статус сервиса и текущее время.",
                "operationId": "checkHealth",
                "responses": {
                    "200": {
                        "description": "Сервис работает",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2024-06-23T12:00:00+00:00"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Check service health",
                "description": "Returns the health status of the service including database, queue, redis, external API and storage checks",
                "operationId": "f5dbd2c909f1ade119d7745ffdce126a",
                "responses": {
                    "200": {
                        "description": "Health check successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "description": "Overall health status: healthy, degraded, or unhealthy",
                                            "type": "string",
                                            "example": "healthy"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2024-01-15T10:30:00Z"
                                        },
                                        "checks": {
                                            "properties": {
                                                "database": {
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "example": "healthy"
                                                        },
                                                        "message": {
                                                            "type": "string",
                                                            "example": "Database connection successful"
                                                        },
                                                        "details": {
                                                            "properties": {
                                                                "tasks_count": {
                                                                    "type": "integer",
                                                                    "example": 42
                                                                },
                                                                "analytics_count": {
                                                                    "type": "integer",
                                                                    "example": 15
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "queue": {
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "example": "healthy"
                                                        },
                                                        "message": {
                                                            "type": "string",
                                                            "example": "Queue is working properly"
                                                        },
                                                        "details": {
                                                            "properties": {
                                                                "failed_jobs": {
                                                                    "type": "integer",
                                                                    "example": 0
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "redis": {
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "example": "healthy"
                                                        },
                                                        "message": {
                                                            "type": "string",
                                                            "example": "Redis connection successful"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "external_api": {
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "example": "healthy"
                                                        },
                                                        "message": {
                                                            "type": "string",
                                                            "example": "External API is working properly"
                                                        },
                                                        "details": {
                                                            "properties": {
                                                                "recent_errors": {
                                                                    "type": "integer",
                                                                    "example": 0
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "storage": {
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "example": "healthy"
                                                        },
                                                        "message": {
                                                            "type": "string",
                                                            "example": "Storage is adequate"
                                                        },
                                                        "details": {
                                                            "properties": {
                                                                "usage_percent": {
                                                                    "type": "number",
                                                                    "format": "float",
                                                                    "example": 45.2
                                                                },
                                                                "free_space_mb": {
                                                                    "type": "number",
                                                                    "format": "float",
                                                                    "example": 1024.5
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service unhealthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "unhealthy"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "checks": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Analytics",
            "description": "Операции с аналитикой распознавания документов"
        },
        {
            "name": "Document Recognition",
            "description": "Операции с распознаванием документов"
        },
        {
            "name": "Health",
            "description": "Health check endpoints"
        }
    ]
}